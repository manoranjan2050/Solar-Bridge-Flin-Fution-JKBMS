[mqtt]
host = 192.168.1.100        # <-- Change to your Home Assistant IP
port = 1883
username = # Leave blank if no auth
password = # Leave blank if no auth
topic_prefix = solar

[inverter]
port = /dev/hidraw0
protocol = PI30             # PI30 for most Axpert clones; try PI18 if PI30 fails
poll_interval = 10          # seconds between reads

[jkbms]
port = /dev/ttyUSB0
baud = 115200
poll_interval = 10          # seconds between reads
cell_count = 16             # adjust to your actual cell count

[dashboard]
username = admin
password = # blank = no login required
hostname = solar            # mDNS name → http://solar.local:8080

[alerts]
enabled = true
low_soc = 20               # % — warn when battery SOC drops below
critical_soc = 10          # % — critical when SOC drops below
high_battery_temp = 50     # °C — warn when any pack temp exceeds
high_inverter_temp = 75    # °C — warn when inverter heatsink exceeds
high_cell_diff = 0.1       # V — warn when cell imbalance exceeds
overload_pct = 90          # % — warn when inverter load exceeds
high_battery_voltage = 57.0 # V — warn on battery over-voltage
cell_overvoltage = 3.65    # V — warn when any cell exceeds
notify_on_grid_loss = true # alert when grid power is lost / restored
notify_on_fault = true     # alert on inverter fault/warning (QPIWS)
notify_on_overload = true  # alert on inverter overload
notify_on_full = true      # notify when battery reaches 100%
cooldown = 1800            # seconds between repeat alerts for the same condition

[telegram]
enabled = false
token =                    # BotFather token, e.g. 123456:ABC-DEF...
chat_id =                  # your chat id (message @userinfobot to get it)
daily_summary = false      # send a once-a-day energy digest
summary_time = 21:00       # HH:MM (24h, Pi local time) to send it

[email]
enabled = false
smtp_host = smtp.gmail.com
smtp_port = 587
username = # sending account
password = # app password (not your login password)
from_addr =
to_addr = # comma-separated recipients

[cost]
currency = ₹              # currency symbol shown on the Details page
import_rate = 8.0         # what you pay the grid per kWh
export_rate = 3.0         # what you earn for exported kWh (0 if no feed-in)

[history]
retain_days = 90          # delete per-minute readings older than this (nightly); 0 disables

